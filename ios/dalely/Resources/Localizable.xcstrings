    "onboarding1Body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ مكان سيارتك بضغطة واحدة، وافتحه في الخرائط عندما تريد العودة. لا مزيد من البحث والحيرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your car with one tap, then open it in Maps when you are ready to walk back. No more wandering around the car park."
          }
        }
      }
    },
    "onboarding1Title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنسَ أين أوقفت سيارتك"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never forget where you parked"
          }
        }
      }
    },
    "onboarding2Body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوبرماركتك، منزلك، الصيدلية والمزيد في قائمة واحدة وعلى خريطة واحدة. شارك أي مكان برابط في أي وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your market, home, pharmacy and more live in one list and on one map. Share any spot, or all of them, with a map link anytime."
          }
        }
      }
    },
    "onboarding2Title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل أماكنك في مكان واحد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your places, one spot"
          }
        }
      }
    },
    "onboarding3Body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء محفوظ محلياً على هذا الجهاز ولا يُرسل لأي مكان. اسمح بالوصول للموقع لحفظ سيارتك ومعرفة مكانك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is saved only on this device and never sent anywhere. Allow location so you can save your car and see where you are."
          }
        }
      }
    },
    "onboarding3Title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أماكنك تظل على هاتفك فقط"
